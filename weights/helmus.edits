UNIT U fo_user_day_report  # the user reports on their day in neutral terms: the reply reacts and asks what happened
VOCAB long  # a word a detector reads: known, so never read as a typo of another word
VOCAB meh  # a word a detector reads: known, so never read as a typo of another word
VOCAB hectic  # a word a detector reads: known, so never read as a typo of another word
VOCAB productive  # a word a detector reads: known, so never read as a typo of another word
VOCAB slow  # a word a detector reads: known, so never read as a typo of another word
UNIT D fo_user_day_report.0  # detector for 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow' (the user reports on their day in neutral terms: the reply reacts and asks what happened)
TAP fo_user_day_report.0 1 1 w:day 1  # 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:day at 1..1
TAP fo_user_day_report.0 2 2 w:was 1  # 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:was at 2..2
TAP fo_user_day_report.0 3 3 w:long|w:busy|w:weird|w:boring|w:chill|w:okay|w:alright|w:meh|w:normal|w:hectic|w:crazy|w:productive|w:slow 1  # 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:long|w:busy|w:weird|w:boring|w:chill|w:okay|w:alright|w:meh|w:normal|w:hectic|w:crazy|w:productive|w:slow at 3..3
TAP fo_user_day_report.0 0 0 w:my 1  # 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:my at 0..0
BIAS D fo_user_day_report.0 -3  # AND of the 4 required parts of 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow'
LINK U fo_user_day_report D:fo_user_day_report.0 1  # 'my day was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow' is one way of saying: the user reports on their day in neutral terms: the reply reacts and asks what happened
UNIT D fo_user_day_report.0.1  # detector for 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow' (the user reports on their day in neutral terms: the reply reacts and asks what happened)
TAP fo_user_day_report.0.1 1 1 w:day 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:day at 1..1
TAP fo_user_day_report.0.1 2 2 w:was 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:was at 2..2
TAP fo_user_day_report.0.1 3 3 c:intens 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs c:intens at 3..3
TAP fo_user_day_report.0.1 4 4 w:long|w:busy|w:weird|w:boring|w:chill|w:okay|w:alright|w:meh|w:normal|w:hectic|w:crazy|w:productive|w:slow 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:long|w:busy|w:weird|w:boring|w:chill|w:okay|w:alright|w:meh|w:normal|w:hectic|w:crazy|w:productive|w:slow at 4..4
TAP fo_user_day_report.0.1 0 0 w:my 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:my at 0..0
BIAS D fo_user_day_report.0.1 -4  # AND of the 5 required parts of 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow'
LINK U fo_user_day_report D:fo_user_day_report.0.1 1  # 'my day was @intens long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow' is one way of saying: the user reports on their day in neutral terms: the reply reacts and asks what happened
UNIT D fo_user_day_report.1  # detector for 'today was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow' (the user reports on their day in neutral terms: the reply reacts and asks what happened)
TAP fo_user_day_report.1 1 1 w:was 1  # 'today was long|busy|weird|boring|chill|okay|alright|meh|normal|hectic|crazy|productive|slow': needs w:was at 1..1
