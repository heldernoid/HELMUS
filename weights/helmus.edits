UNIT U user_question  # the user turns the question back
UNIT D user_question.0  # detector for 'what about you' (the user turns the question back)
TAP user_question.0 1 1 w:about 1  # 'what about you': needs w:about at 1..1
TAP user_question.0 2 2 w:you 1  # 'what about you': needs w:you at 2..2
TAP user_question.0 0 0 w:what 1  # 'what about you': needs w:what at 0..0
BIAS D user_question.0 -2  # AND of the 3 required parts of 'what about you'
