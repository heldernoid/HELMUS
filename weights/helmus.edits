TAP bt_type_word.5 -1 -1 w:say 1  # '^ say {word} $': needs w:say at -1..-1
TAP bt_type_word.5 -1 -1 pos:start 1  # '^ say {word} $': needs pos:start at -1..-1
TAP bt_type_word.5 0 0 shape:any 1  # '^ say {word} $': needs shape:any at 0..0
BIAS D bt_type_word.5 -3  # AND of the 4 required parts of '^ say {word} $'
LINK U bt_type_word D:bt_type_word.5 1  # '^ say {word} $' is one way of saying: asks Helmus to type one exact word (banana): a reply does it, or asks why
UNIT D bt_type_word.6  # detector for 'just say {word}' (asks Helmus to type one exact word (banana): a reply does it, or asks why)
