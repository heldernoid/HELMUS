UNIT U bt_accuse_types_fast  # says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply)
UNIT D bt_accuse_types_fast.0  # detector for 'you type fast|quick|quickly' (says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply))
TAP bt_accuse_types_fast.0 1 1 w:type 1  # 'you type fast|quick|quickly': needs w:type at 1..1
TAP bt_accuse_types_fast.0 2 2 w:fast|w:quick|w:quickly 1  # 'you type fast|quick|quickly': needs w:fast|w:quick|w:quickly at 2..2
TAP bt_accuse_types_fast.0 0 0 w:you 1  # 'you type fast|quick|quickly': needs w:you at 0..0
BIAS D bt_accuse_types_fast.0 -2  # AND of the 3 required parts of 'you type fast|quick|quickly'
LINK U bt_accuse_types_fast D:bt_accuse_types_fast.0 1  # 'you type fast|quick|quickly' is one way of saying: says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply)
UNIT D bt_accuse_types_fast.0.1  # detector for 'you type @intens fast|quick|quickly' (says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply))
TAP bt_accuse_types_fast.0.1 1 1 w:type 1  # 'you type @intens fast|quick|quickly': needs w:type at 1..1
TAP bt_accuse_types_fast.0.1 2 2 c:intens 1  # 'you type @intens fast|quick|quickly': needs c:intens at 2..2
TAP bt_accuse_types_fast.0.1 3 3 w:fast|w:quick|w:quickly 1  # 'you type @intens fast|quick|quickly': needs w:fast|w:quick|w:quickly at 3..3
TAP bt_accuse_types_fast.0.1 0 0 w:you 1  # 'you type @intens fast|quick|quickly': needs w:you at 0..0
BIAS D bt_accuse_types_fast.0.1 -3  # AND of the 4 required parts of 'you type @intens fast|quick|quickly'
LINK U bt_accuse_types_fast D:bt_accuse_types_fast.0.1 1  # 'you type @intens fast|quick|quickly' is one way of saying: says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply)
UNIT D bt_accuse_types_fast.1  # detector for 'you typed that fast|quick|quickly' (says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply))
TAP bt_accuse_types_fast.1 1 1 w:typed 1  # 'you typed that fast|quick|quickly': needs w:typed at 1..1
TAP bt_accuse_types_fast.1 2 2 w:that 1  # 'you typed that fast|quick|quickly': needs w:that at 2..2
TAP bt_accuse_types_fast.1 3 3 w:fast|w:quick|w:quickly 1  # 'you typed that fast|quick|quickly': needs w:fast|w:quick|w:quickly at 3..3
TAP bt_accuse_types_fast.1 0 0 w:you 1  # 'you typed that fast|quick|quickly': needs w:you at 0..0
BIAS D bt_accuse_types_fast.1 -3  # AND of the 4 required parts of 'you typed that fast|quick|quickly'
LINK U bt_accuse_types_fast D:bt_accuse_types_fast.1 1  # 'you typed that fast|quick|quickly' is one way of saying: says Helmus answers too fast to be typing: a reply shrugs it off (fast typer, short reply)
