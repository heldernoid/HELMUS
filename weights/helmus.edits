UNIT U whats_up  # asks what Helmus is up to
UNIT D whats_up.0  # detector for '^ what is up' (asks what Helmus is up to)
TAP whats_up.0 1 1 w:is 1  # '^ what is up': needs w:is at 1..1
TAP whats_up.0 2 2 w:up 1  # '^ what is up': needs w:up at 2..2
TAP whats_up.0 0 0 pos:start 1  # '^ what is up': needs pos:start at 0..0
TAP whats_up.0 0 0 w:what 1  # '^ what is up': needs w:what at 0..0
BIAS D whats_up.0 -3  # AND of the 4 required parts of '^ what is up'
LINK U whats_up D:whats_up.0 1  # '^ what is up' is one way of saying: asks what Helmus is up to
UNIT D whats_up.0.1  # detector for '^ @greet what is up' (asks what Helmus is up to)
TAP whats_up.0.1 1 1 w:what 1  # '^ @greet what is up': needs w:what at 1..1
TAP whats_up.0.1 2 2 w:is 1  # '^ @greet what is up': needs w:is at 2..2
TAP whats_up.0.1 3 3 w:up 1  # '^ @greet what is up': needs w:up at 3..3
TAP whats_up.0.1 0 0 pos:start 1  # '^ @greet what is up': needs pos:start at 0..0
TAP whats_up.0.1 0 0 c:greet 1  # '^ @greet what is up': needs c:greet at 0..0
BIAS D whats_up.0.1 -4  # AND of the 5 required parts of '^ @greet what is up'
LINK U whats_up D:whats_up.0.1 1  # '^ @greet what is up' is one way of saying: asks what Helmus is up to
UNIT D whats_up.1  # detector for 'what is good' (asks what Helmus is up to)
TAP whats_up.1 1 1 w:is 1  # 'what is good': needs w:is at 1..1
TAP whats_up.1 2 2 w:good 1  # 'what is good': needs w:good at 2..2
TAP whats_up.1 0 0 w:what 1  # 'what is good': needs w:what at 0..0
BIAS D whats_up.1 -2  # AND of the 3 required parts of 'what is good'
LINK U whats_up D:whats_up.1 1  # 'what is good' is one way of saying: asks what Helmus is up to
