TAP how_are_you.7 2 2 w:good 1  # 'are you good $': needs w:good at 2..2
TAP how_are_you.7 2 2 pos:end 1  # 'are you good $': needs pos:end at 2..2
TAP how_are_you.7 0 0 w:are 1  # 'are you good $': needs w:are at 0..0
BIAS D how_are_you.7 -3  # AND of the 4 required parts of 'are you good $'
LINK U how_are_you D:how_are_you.7 1  # 'are you good $' is one way of saying: asks how Helmus is
