UNIT U fo_ask_cats_or_dogs  # asks whether Helmus is a cat or a dog person: the reply picks one, from the persona
VOCAB cats  # a word a detector reads: known, so never read as a typo of another word
VOCAB dogs  # a word a detector reads: known, so never read as a typo of another word
UNIT D fo_ask_cats_or_dogs.0  # detector for 'cats|cat or dogs|dog' (asks whether Helmus is a cat or a dog person: the reply picks one, from the persona)
TAP fo_ask_cats_or_dogs.0 1 1 w:or 1  # 'cats|cat or dogs|dog': needs w:or at 1..1
TAP fo_ask_cats_or_dogs.0 2 2 w:dogs|w:dog 1  # 'cats|cat or dogs|dog': needs w:dogs|w:dog at 2..2
TAP fo_ask_cats_or_dogs.0 0 0 w:cats|w:cat 1  # 'cats|cat or dogs|dog': needs w:cats|w:cat at 0..0
BIAS D fo_ask_cats_or_dogs.0 -2  # AND of the 3 required parts of 'cats|cat or dogs|dog'
LINK U fo_ask_cats_or_dogs D:fo_ask_cats_or_dogs.0 1  # 'cats|cat or dogs|dog' is one way of saying: asks whether Helmus is a cat or a dog person: the reply picks one, from the persona
UNIT D fo_ask_cats_or_dogs.1  # detector for 'dogs|dog or cats|cat' (asks whether Helmus is a cat or a dog person: the reply picks one, from the persona)
TAP fo_ask_cats_or_dogs.1 1 1 w:or 1  # 'dogs|dog or cats|cat': needs w:or at 1..1
TAP fo_ask_cats_or_dogs.1 2 2 w:cats|w:cat 1  # 'dogs|dog or cats|cat': needs w:cats|w:cat at 2..2
TAP fo_ask_cats_or_dogs.1 0 0 w:dogs|w:dog 1  # 'dogs|dog or cats|cat': needs w:dogs|w:dog at 0..0
BIAS D fo_ask_cats_or_dogs.1 -2  # AND of the 3 required parts of 'dogs|dog or cats|cat'
LINK U fo_ask_cats_or_dogs D:fo_ask_cats_or_dogs.1 1  # 'dogs|dog or cats|cat' is one way of saying: asks whether Helmus is a cat or a dog person: the reply picks one, from the persona
UNIT D fo_ask_cats_or_dogs.2  # detector for 'cat|dog person' (asks whether Helmus is a cat or a dog person: the reply picks one, from the persona)
TAP fo_ask_cats_or_dogs.2 1 1 w:person 1  # 'cat|dog person': needs w:person at 1..1
