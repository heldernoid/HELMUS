TAP fo_user_feels_good.6 1 1 w:am 1  # 'i am !not excited|hyped|pumped|stoked': needs w:am at 1..1
TAP fo_user_feels_good.6 0 1 w:not -1  # 'i am !not excited|hyped|pumped|stoked': blocked by w:not at 0..1
TAP fo_user_feels_good.6 2 2 w:excited|w:hyped|w:pumped|w:stoked 1  # 'i am !not excited|hyped|pumped|stoked': needs w:excited|w:hyped|w:pumped|w:stoked at 2..2
TAP fo_user_feels_good.6 0 0 w:i 1  # 'i am !not excited|hyped|pumped|stoked': needs w:i at 0..0
BIAS D fo_user_feels_good.6 -2  # AND of the 3 required parts of 'i am !not excited|hyped|pumped|stoked'
LINK U fo_user_feels_good D:fo_user_feels_good.6 1  # 'i am !not excited|hyped|pumped|stoked' is one way of saying: the user feels good or is excited, including with intensifiers core's user_happy misses ('so happy rn', 'cant wait'): the reply is glad and asks what
