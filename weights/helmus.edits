TAP fo_ask_recall_user_taste.2 1 1 w:did 1  # 'what did i say i like|love|hate': needs w:did at 1..1
TAP fo_ask_recall_user_taste.2 2 2 w:i 1  # 'what did i say i like|love|hate': needs w:i at 2..2
