TAP ks_tell_my_daypart.2.1 5 5 w:i 1  # 'it is @intens late|early where i': needs w:i at 5..5
TAP ks_tell_my_daypart.2.1 0 0 w:it 1  # 'it is @intens late|early where i': needs w:it at 0..0
BIAS D ks_tell_my_daypart.2.1 -5  # AND of the 6 required parts of 'it is @intens late|early where i'
