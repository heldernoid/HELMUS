TAP fo_user_scared.6 0 0 w:i 1  # 'i have a fear of': needs w:i at 0..0
BIAS D fo_user_scared.6 -4  # AND of the 5 required parts of 'i have a fear of'
LINK U fo_user_scared D:fo_user_scared.6 1  # 'i have a fear of' is one way of saying: the user says what they are afraid of
UNIT D fo_user_scared.7  # detector for 'i fear' (the user says what they are afraid of)
TAP fo_user_scared.7 1 1 w:fear 1  # 'i fear': needs w:fear at 1..1
TAP fo_user_scared.7 0 0 w:i 1  # 'i fear': needs w:i at 0..0
BIAS D fo_user_scared.7 -1  # AND of the 2 required parts of 'i fear'
LINK U fo_user_scared D:fo_user_scared.7 1  # 'i fear' is one way of saying: the user says what they are afraid of
REG fo_user_fear fo_user_scared.0 U:fo_user_scared  # what the user said they are afraid of
REG fo_user_fear fo_user_scared.0.1 U:fo_user_scared  # what the user said they are afraid of
REG fo_user_fear fo_user_scared.1 U:fo_user_scared  # what the user said they are afraid of
REG fo_user_fear fo_user_scared.1.1 U:fo_user_scared  # what the user said they are afraid of
