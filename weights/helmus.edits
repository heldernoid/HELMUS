TAP bt_yesno_bare.0 1 1 w:/ 1  # '^ y / n $': needs w:/ at 1..1
TAP bt_yesno_bare.0 2 2 w:n 1  # '^ y / n $': needs w:n at 2..2
TAP bt_yesno_bare.0 2 2 pos:end 1  # '^ y / n $': needs pos:end at 2..2
TAP bt_yesno_bare.0 0 0 pos:start 1  # '^ y / n $': needs pos:start at 0..0
TAP bt_yesno_bare.0 0 0 w:y 1  # '^ y / n $': needs w:y at 0..0
BIAS D bt_yesno_bare.0 -4  # AND of the 5 required parts of '^ y / n $'
LINK U bt_yesno_bare D:bt_yesno_bare.0 1  # '^ y / n $' is one way of saying: a bare demand for a yes or no: a reply answers the question it follows (after a denial: human)
UNIT D bt_yesno_bare.1  # detector for '^ y n $' (a bare demand for a yes or no: a reply answers the question it follows (after a denial: human))
TAP bt_yesno_bare.1 1 1 w:n 1  # '^ y n $': needs w:n at 1..1
TAP bt_yesno_bare.1 1 1 pos:end 1  # '^ y n $': needs pos:end at 1..1
TAP bt_yesno_bare.1 0 0 pos:start 1  # '^ y n $': needs pos:start at 0..0
TAP bt_yesno_bare.1 0 0 w:y 1  # '^ y n $': needs w:y at 0..0
BIAS D bt_yesno_bare.1 -3  # AND of the 4 required parts of '^ y n $'
LINK U bt_yesno_bare D:bt_yesno_bare.1 1  # '^ y n $' is one way of saying: a bare demand for a yes or no: a reply answers the question it follows (after a denial: human)
UNIT D bt_yesno_bare.2  # detector for '^ y or n $' (a bare demand for a yes or no: a reply answers the question it follows (after a denial: human))
TAP bt_yesno_bare.2 1 1 w:or 1  # '^ y or n $': needs w:or at 1..1
TAP bt_yesno_bare.2 2 2 w:n 1  # '^ y or n $': needs w:n at 2..2
TAP bt_yesno_bare.2 2 2 pos:end 1  # '^ y or n $': needs pos:end at 2..2
TAP bt_yesno_bare.2 0 0 pos:start 1  # '^ y or n $': needs pos:start at 0..0
TAP bt_yesno_bare.2 0 0 w:y 1  # '^ y or n $': needs w:y at 0..0
BIAS D bt_yesno_bare.2 -4  # AND of the 5 required parts of '^ y or n $'
LINK U bt_yesno_bare D:bt_yesno_bare.2 1  # '^ y or n $' is one way of saying: a bare demand for a yes or no: a reply answers the question it follows (after a denial: human)
UNIT D bt_yesno_bare.3  # detector for '^ yes or no $' (a bare demand for a yes or no: a reply answers the question it follows (after a denial: human))
TAP bt_yesno_bare.3 1 1 w:or 1  # '^ yes or no $': needs w:or at 1..1
TAP bt_yesno_bare.3 2 2 w:no 1  # '^ yes or no $': needs w:no at 2..2
TAP bt_yesno_bare.3 2 2 pos:end 1  # '^ yes or no $': needs pos:end at 2..2
TAP bt_yesno_bare.3 0 0 pos:start 1  # '^ yes or no $': needs pos:start at 0..0
TAP bt_yesno_bare.3 0 0 w:yes 1  # '^ yes or no $': needs w:yes at 0..0
BIAS D bt_yesno_bare.3 -4  # AND of the 5 required parts of '^ yes or no $'
LINK U bt_yesno_bare D:bt_yesno_bare.3 1  # '^ yes or no $' is one way of saying: a bare demand for a yes or no: a reply answers the question it follows (after a denial: human)
UNIT D bt_yesno_bare.3.1  # detector for '^ yes or no then $' (a bare demand for a yes or no: a reply answers the question it follows (after a denial: human))
TAP bt_yesno_bare.3.1 1 1 w:or 1  # '^ yes or no then $': needs w:or at 1..1
