UNIT D ask_why.1  # detector for 'why not' (asks why)
TAP ask_why.1 1 1 w:not 1  # 'why not': needs w:not at 1..1
TAP ask_why.1 0 0 w:why 1  # 'why not': needs w:why at 0..0
BIAS D ask_why.1 -1  # AND of the 2 required parts of 'why not'
LINK U ask_why D:ask_why.1 1  # 'why not' is one way of saying: asks why
VOCAB come  # a word a detector reads: known, so never read as a typo of another word
UNIT D ask_why.2  # detector for 'how come' (asks why)
TAP ask_why.2 1 1 w:come 1  # 'how come': needs w:come at 1..1
TAP ask_why.2 0 0 w:how 1  # 'how come': needs w:how at 0..0
BIAS D ask_why.2 -1  # AND of the 2 required parts of 'how come'
LINK U ask_why D:ask_why.2 1  # 'how come' is one way of saying: asks why
UNIT U tell_from  # the user says where they are from
UNIT D tell_from.0  # detector for 'i am from {place:content}' (the user says where they are from)
TAP tell_from.0 -1 -1 w:from 1  # 'i am from {place:content}': needs w:from at -1..-1
TAP tell_from.0 -2 -2 w:am 1  # 'i am from {place:content}': needs w:am at -2..-2
TAP tell_from.0 -3 -3 w:i 1  # 'i am from {place:content}': needs w:i at -3..-3
TAP tell_from.0 0 0 shape:content 1  # 'i am from {place:content}': needs shape:content at 0..0
BIAS D tell_from.0 -3  # AND of the 4 required parts of 'i am from {place:content}'
LINK U tell_from D:tell_from.0 1  # 'i am from {place:content}' is one way of saying: the user says where they are from
UNIT D tell_from.1  # detector for 'i live in {place:content}' (the user says where they are from)
TAP tell_from.1 -1 -1 w:in 1  # 'i live in {place:content}': needs w:in at -1..-1
TAP tell_from.1 -2 -2 w:live 1  # 'i live in {place:content}': needs w:live at -2..-2
TAP tell_from.1 -3 -3 w:i 1  # 'i live in {place:content}': needs w:i at -3..-3
TAP tell_from.1 0 0 shape:content 1  # 'i live in {place:content}': needs shape:content at 0..0
BIAS D tell_from.1 -3  # AND of the 4 required parts of 'i live in {place:content}'
LINK U tell_from D:tell_from.1 1  # 'i live in {place:content}' is one way of saying: the user says where they are from
UNIT D tell_from.2  # detector for 'i am in {place:unknown}' (the user says where they are from)
TAP tell_from.2 -1 -1 w:in 1  # 'i am in {place:unknown}': needs w:in at -1..-1
TAP tell_from.2 -2 -2 w:am 1  # 'i am in {place:unknown}': needs w:am at -2..-2
TAP tell_from.2 -3 -3 w:i 1  # 'i am in {place:unknown}': needs w:i at -3..-3
TAP tell_from.2 0 0 shape:unknown 1  # 'i am in {place:unknown}': needs shape:unknown at 0..0
BIAS D tell_from.2 -3  # AND of the 4 required parts of 'i am in {place:unknown}'
LINK U tell_from D:tell_from.2 1  # 'i am in {place:unknown}' is one way of saying: the user says where they are from
UNIT D tell_from.3  # detector for '^ from {place:content} $' (the user says where they are from)
TAP tell_from.3 0 0 pos:end 1  # '^ from {place:content} $': needs pos:end at 0..0
TAP tell_from.3 -1 -1 w:from 1  # '^ from {place:content} $': needs w:from at -1..-1
TAP tell_from.3 -1 -1 pos:start 1  # '^ from {place:content} $': needs pos:start at -1..-1
TAP tell_from.3 0 0 shape:content 1  # '^ from {place:content} $': needs shape:content at 0..0
BIAS D tell_from.3 -3  # AND of the 4 required parts of '^ from {place:content} $'
LINK U tell_from D:tell_from.3 1  # '^ from {place:content} $' is one way of saying: the user says where they are from
REG user_place tell_from.0 U:tell_from  # where the user said they are from
REG user_place tell_from.1 U:tell_from  # where the user said they are from
REG user_place tell_from.2 U:tell_from  # where the user said they are from
REG user_place tell_from.3 U:tell_from  # where the user said they are from
