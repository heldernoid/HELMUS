UNIT U fo_user_tells_favorite  # the user names a favourite of theirs: the reply reacts and remembers it
UNIT D fo_user_tells_favorite.0  # detector for 'my favorite * is the {thing}' (the user names a favourite of theirs: the reply reacts and remembers it)
TAP fo_user_tells_favorite.0 -1 -1 w:the 1  # 'my favorite * is the {thing}': needs w:the at -1..-1
TAP fo_user_tells_favorite.0 -2 -2 w:is 1  # 'my favorite * is the {thing}': needs w:is at -2..-2
TAP fo_user_tells_favorite.0 -6 -3 w:favorite 1  # 'my favorite * is the {thing}': needs w:favorite at -6..-3
TAP fo_user_tells_favorite.0 -7 -4 w:my 1  # 'my favorite * is the {thing}': needs w:my at -7..-4
TAP fo_user_tells_favorite.0 0 0 shape:any 1  # 'my favorite * is the {thing}': needs shape:any at 0..0
BIAS D fo_user_tells_favorite.0 -4  # AND of the 5 required parts of 'my favorite * is the {thing}'
LINK U fo_user_tells_favorite D:fo_user_tells_favorite.0 1  # 'my favorite * is the {thing}' is one way of saying: the user names a favourite of theirs: the reply reacts and remembers it
UNIT D fo_user_tells_favorite.1  # detector for 'my favorite * is {thing}' (the user names a favourite of theirs: the reply reacts and remembers it)
