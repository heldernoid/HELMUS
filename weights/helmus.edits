LINK U fo_user_tells_favorite D:fo_user_tells_favorite.2 1  # 'my * favorite * is {thing}' is one way of saying: the user names a favourite of theirs: the reply reacts and remembers it
UNIT D fo_user_tells_favorite.3  # detector for '{thing} is my favorite' (the user names a favourite of theirs: the reply reacts and remembers it)
TAP fo_user_tells_favorite.3 1 1 w:is 1  # '{thing} is my favorite': needs w:is at 1..1
TAP fo_user_tells_favorite.3 2 2 w:my 1  # '{thing} is my favorite': needs w:my at 2..2
TAP fo_user_tells_favorite.3 3 3 w:favorite 1  # '{thing} is my favorite': needs w:favorite at 3..3
TAP fo_user_tells_favorite.3 0 0 shape:any 1  # '{thing} is my favorite': needs shape:any at 0..0
