UNIT U ks_ask_who_said_quote  # asks who said a famous quote (reply: the very famous ones only, 'mlk?')
UNIT D ks_ask_who_said_quote.0  # detector for '^ who said {x} {y}' (asks who said a famous quote (reply: the very famous ones only, 'mlk?'))
TAP ks_ask_who_said_quote.0 1 1 shape:any 1  # '^ who said {x} {y}': needs shape:any at 1..1
TAP ks_ask_who_said_quote.0 -1 -1 w:said 1  # '^ who said {x} {y}': needs w:said at -1..-1
TAP ks_ask_who_said_quote.0 -2 -2 w:who 1  # '^ who said {x} {y}': needs w:who at -2..-2
TAP ks_ask_who_said_quote.0 -2 -2 pos:start 1  # '^ who said {x} {y}': needs pos:start at -2..-2
TAP ks_ask_who_said_quote.0 0 0 shape:any 1  # '^ who said {x} {y}': needs shape:any at 0..0
BIAS D ks_ask_who_said_quote.0 -4  # AND of the 5 required parts of '^ who said {x} {y}'
LINK U ks_ask_who_said_quote D:ks_ask_who_said_quote.0 1  # '^ who said {x} {y}' is one way of saying: asks who said a famous quote (reply: the very famous ones only, 'mlk?')
VOCAB quote  # a word a detector reads: known, so never read as a typo of another word
UNIT D ks_ask_who_said_quote.1  # detector for 'finish the|this quote' (asks who said a famous quote (reply: the very famous ones only, 'mlk?'))
TAP ks_ask_who_said_quote.1 1 1 w:the|w:this 1  # 'finish the|this quote': needs w:the|w:this at 1..1
TAP ks_ask_who_said_quote.1 2 2 w:quote 1  # 'finish the|this quote': needs w:quote at 2..2
TAP ks_ask_who_said_quote.1 0 0 w:finish 1  # 'finish the|this quote': needs w:finish at 0..0
