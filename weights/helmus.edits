TAP ack.0.1 1 1 pos:end 1  # '^ okay|alright|fair|true|bet|cool|nice|word|gotcha|interesting|facts|same @laugh $': needs pos:end at 1..1
TAP ack.0.1 0 0 pos:start 1  # '^ okay|alright|fair|true|bet|cool|nice|word|gotcha|interesting|facts|same @laugh $': needs pos:start at 0..0
TAP ack.0.1 0 0 w:okay|w:alright|w:fair|w:true|w:bet|w:cool|w:nice|w:word|w:gotcha|w:interesting|w:facts|w:same 1  # '^ okay|alright|fair|true|bet|cool|nice|word|gotcha|interesting|facts|same @laugh $': needs w:okay|w:alright|w:fair|w:true|w:bet|w:cool|w:nice|w:word|w:gotcha|w:interesting|w:facts|w:same at 0..0
