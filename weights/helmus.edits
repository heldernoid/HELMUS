TAP fo_ask_recall_user_taste.1 2 2 w:remember 1  # 'do you remember my favorite': needs w:remember at 2..2
TAP fo_ask_recall_user_taste.1 3 3 w:my 1  # 'do you remember my favorite': needs w:my at 3..3
TAP fo_ask_recall_user_taste.1 4 4 w:favorite 1  # 'do you remember my favorite': needs w:favorite at 4..4
TAP fo_ask_recall_user_taste.1 0 0 w:do 1  # 'do you remember my favorite': needs w:do at 0..0
BIAS D fo_ask_recall_user_taste.1 -4  # AND of the 5 required parts of 'do you remember my favorite'
LINK U fo_ask_recall_user_taste D:fo_ask_recall_user_taste.1 1  # 'do you remember my favorite' is one way of saying: tests whether Helmus remembers what the user said they like (a memory probe)
