TAP ask_joke.3 2 2 w:jokes 1  # 'know any jokes': needs w:jokes at 2..2
TAP ask_joke.3 0 0 w:know 1  # 'know any jokes': needs w:know at 0..0
BIAS D ask_joke.3 -2  # AND of the 3 required parts of 'know any jokes'
LINK U ask_joke D:ask_joke.3 1  # 'know any jokes' is one way of saying: asks for a joke
