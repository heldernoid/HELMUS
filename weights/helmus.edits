TAP tell_name.0.1 -4 -4 pos:start 1  # '^ hi|hey|hello my name is {name:content}': needs pos:start at -4..-4
TAP tell_name.0.1 0 0 shape:content 1  # '^ hi|hey|hello my name is {name:content}': needs shape:content at 0..0
