BIAS D fo_user_tells_favorite.1 -3  # AND of the 4 required parts of 'my favorite * is {thing}'
LINK U fo_user_tells_favorite D:fo_user_tells_favorite.1 1  # 'my favorite * is {thing}' is one way of saying: the user names a favourite of theirs: the reply reacts and remembers it
