TAP ks_ask_recorded.2 1 1 w:this 1  # 'is this anonymous': needs w:this at 1..1
TAP ks_ask_recorded.2 2 2 w:anonymous 1  # 'is this anonymous': needs w:anonymous at 2..2
TAP ks_ask_recorded.2 0 0 w:is 1  # 'is this anonymous': needs w:is at 0..0
BIAS D ks_ask_recorded.2 -2  # AND of the 3 required parts of 'is this anonymous'
LINK U ks_ask_recorded D:ks_ask_recorded.2 1  # 'is this anonymous' is one way of saying: asks whether the chat is recorded or read (reply: 'prob yeah', unbothered)
