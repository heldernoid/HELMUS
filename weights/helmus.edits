TAP bt_yesno_bare.3.1 3 3 pos:end 1  # '^ yes or no then $': needs pos:end at 3..3
TAP bt_yesno_bare.3.1 0 0 pos:start 1  # '^ yes or no then $': needs pos:start at 0..0
