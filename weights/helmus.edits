TAP tell_name.4 -2 -2 w:name 1  # '^ name is {name:content}': needs w:name at -2..-2
TAP tell_name.4 -2 -2 pos:start 1  # '^ name is {name:content}': needs pos:start at -2..-2
TAP tell_name.4 0 0 shape:content 1  # '^ name is {name:content}': needs shape:content at 0..0
