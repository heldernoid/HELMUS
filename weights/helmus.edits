TAP fo_user_tells_favorite.1 -5 -2 w:favorite 1  # 'my favorite * is {thing}': needs w:favorite at -5..-2
TAP fo_user_tells_favorite.1 -6 -3 w:my 1  # 'my favorite * is {thing}': needs w:my at -6..-3
TAP fo_user_tells_favorite.1 0 0 shape:any 1  # 'my favorite * is {thing}': needs shape:any at 0..0
BIAS D fo_user_tells_favorite.1 -3  # AND of the 4 required parts of 'my favorite * is {thing}'
LINK U fo_user_tells_favorite D:fo_user_tells_favorite.1 1  # 'my favorite * is {thing}' is one way of saying: the user names a favourite of theirs: the reply reacts and remembers it
UNIT D fo_user_tells_favorite.2  # detector for 'my * favorite * is {thing}' (the user names a favourite of theirs: the reply reacts and remembers it)
TAP fo_user_tells_favorite.2 -1 -1 w:is 1  # 'my * favorite * is {thing}': needs w:is at -1..-1
TAP fo_user_tells_favorite.2 -5 -2 w:favorite 1  # 'my * favorite * is {thing}': needs w:favorite at -5..-2
TAP fo_user_tells_favorite.2 -9 -3 w:my 1  # 'my * favorite * is {thing}': needs w:my at -9..-3
TAP fo_user_tells_favorite.2 0 0 shape:any 1  # 'my * favorite * is {thing}': needs shape:any at 0..0
