REG fo_user_favorite fo_user_tells_favorite.0 U:fo_user_tells_favorite  # the favourite the user named
REG fo_user_favorite fo_user_tells_favorite.1 U:fo_user_tells_favorite  # the favourite the user named
REG fo_user_favorite fo_user_tells_favorite.2 U:fo_user_tells_favorite  # the favourite the user named
