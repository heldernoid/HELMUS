VOCAB this  # a word a detector reads: known, so never read as a typo of another word
UNIT D tell_name.5  # detector for '^ this is {name:unknown}' (the user says their name)
TAP tell_name.5 -1 -1 w:is 1  # '^ this is {name:unknown}': needs w:is at -1..-1
TAP tell_name.5 -2 -2 w:this 1  # '^ this is {name:unknown}': needs w:this at -2..-2
TAP tell_name.5 -2 -2 pos:start 1  # '^ this is {name:unknown}': needs pos:start at -2..-2
TAP tell_name.5 0 0 shape:unknown 1  # '^ this is {name:unknown}': needs shape:unknown at 0..0
