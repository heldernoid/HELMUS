TAP fo_user_scared.5 3 3 w:phobia 1  # 'i have a phobia': needs w:phobia at 3..3
TAP fo_user_scared.5 0 0 w:i 1  # 'i have a phobia': needs w:i at 0..0
BIAS D fo_user_scared.5 -3  # AND of the 4 required parts of 'i have a phobia'
LINK U fo_user_scared D:fo_user_scared.5 1  # 'i have a phobia' is one way of saying: the user says what they are afraid of
UNIT D fo_user_scared.6  # detector for 'i have a fear of' (the user says what they are afraid of)
TAP fo_user_scared.6 1 1 w:have 1  # 'i have a fear of': needs w:have at 1..1
TAP fo_user_scared.6 2 2 w:a 1  # 'i have a fear of': needs w:a at 2..2
TAP fo_user_scared.6 3 3 w:fear 1  # 'i have a fear of': needs w:fear at 3..3
