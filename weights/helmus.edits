TAP ks_ask_superlative_fact.1 2 2 w:the 1  # 'who is the @ks_superl': needs w:the at 2..2
TAP ks_ask_superlative_fact.1 3 3 c:ks_superl 1  # 'who is the @ks_superl': needs c:ks_superl at 3..3
TAP ks_ask_superlative_fact.1 0 0 w:who 1  # 'who is the @ks_superl': needs w:who at 0..0
BIAS D ks_ask_superlative_fact.1 -3  # AND of the 4 required parts of 'who is the @ks_superl'
LINK U ks_ask_superlative_fact D:ks_ask_superlative_fact.1 1  # 'who is the @ks_superl' is one way of saying: asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged)
UNIT D ks_ask_superlative_fact.2  # detector for '@ks_superl * in the world' (asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged))
TAP ks_ask_superlative_fact.2 1 4 w:in 1  # '@ks_superl * in the world': needs w:in at 1..4
TAP ks_ask_superlative_fact.2 2 5 w:the 1  # '@ks_superl * in the world': needs w:the at 2..5
TAP ks_ask_superlative_fact.2 3 6 w:world 1  # '@ks_superl * in the world': needs w:world at 3..6
TAP ks_ask_superlative_fact.2 0 0 c:ks_superl 1  # '@ks_superl * in the world': needs c:ks_superl at 0..0
BIAS D ks_ask_superlative_fact.2 -3  # AND of the 4 required parts of '@ks_superl * in the world'
LINK U ks_ask_superlative_fact D:ks_ask_superlative_fact.2 1  # '@ks_superl * in the world' is one way of saying: asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged)
VOCAB animals  # a word a detector reads: known, so never read as a typo of another word
VOCAB mammal  # a word a detector reads: known, so never read as a typo of another word
UNIT D ks_ask_superlative_fact.3  # detector for '@ks_superl animal|animals|country|planet|ocean|river|mountain|city|building|man|person|bird|mammal' (asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged))
TAP ks_ask_superlative_fact.3 1 1 w:animal|w:animals|w:country|w:planet|w:ocean|w:river|w:mountain|w:city|w:building|w:man|w:person|w:bird|w:mammal 1  # '@ks_superl animal|animals|country|planet|ocean|river|mountain|city|building|man|person|bird|mammal': needs w:animal|w:animals|w:country|w:planet|w:ocean|w:river|w:mountain|w:city|w:building|w:man|w:person|w:bird|w:mammal at 1..1
TAP ks_ask_superlative_fact.3 0 0 c:ks_superl 1  # '@ks_superl animal|animals|country|planet|ocean|river|mountain|city|building|man|person|bird|mammal': needs c:ks_superl at 0..0
BIAS D ks_ask_superlative_fact.3 -1  # AND of the 2 required parts of '@ks_superl animal|animals|country|planet|ocean|river|mountain|city|building|man|person|bird|mammal'
LINK U ks_ask_superlative_fact D:ks_ask_superlative_fact.3 1  # '@ks_superl animal|animals|country|planet|ocean|river|mountain|city|building|man|person|bird|mammal' is one way of saying: asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged)
UNIT D ks_ask_superlative_fact.4  # detector for 'name the @ks_superl' (asks the biggest, fastest, richest something (reply: the famous ones are known, the rest shrugged))
TAP ks_ask_superlative_fact.4 1 1 w:the 1  # 'name the @ks_superl': needs w:the at 1..1
TAP ks_ask_superlative_fact.4 2 2 c:ks_superl 1  # 'name the @ks_superl': needs c:ks_superl at 2..2
