UNIT U greet  # a greeting at the start of a message
UNIT D greet.0  # detector for '^ @greet' (a greeting at the start of a message)
TAP greet.0 0 0 pos:start 1  # '^ @greet': needs pos:start at 0..0
TAP greet.0 0 0 c:greet 1  # '^ @greet': needs c:greet at 0..0
BIAS D greet.0 -1  # AND of the 2 required parts of '^ @greet'
LINK U greet D:greet.0 1  # '^ @greet' is one way of saying: a greeting at the start of a message
VOCAB good  # a word a detector reads: known, so never read as a typo of another word
UNIT D greet.1  # detector for '^ good morning|afternoon|evening' (a greeting at the start of a message)
TAP greet.1 1 1 w:morning|w:afternoon|w:evening 1  # '^ good morning|afternoon|evening': needs w:morning|w:afternoon|w:evening at 1..1
TAP greet.1 0 0 pos:start 1  # '^ good morning|afternoon|evening': needs pos:start at 0..0
TAP greet.1 0 0 w:good 1  # '^ good morning|afternoon|evening': needs w:good at 0..0
BIAS D greet.1 -2  # AND of the 3 required parts of '^ good morning|afternoon|evening'
LINK U greet D:greet.1 1  # '^ good morning|afternoon|evening' is one way of saying: a greeting at the start of a message
VOCAB what  # a word a detector reads: known, so never read as a typo of another word
VOCAB is  # a word a detector reads: known, so never read as a typo of another word
VOCAB up  # a word a detector reads: known, so never read as a typo of another word
UNIT D greet.2  # detector for '^ what is up' (a greeting at the start of a message)
TAP greet.2 1 1 w:is 1  # '^ what is up': needs w:is at 1..1
TAP greet.2 2 2 w:up 1  # '^ what is up': needs w:up at 2..2
TAP greet.2 0 0 pos:start 1  # '^ what is up': needs pos:start at 0..0
TAP greet.2 0 0 w:what 1  # '^ what is up': needs w:what at 0..0
BIAS D greet.2 -3  # AND of the 4 required parts of '^ what is up'
LINK U greet D:greet.2 1  # '^ what is up' is one way of saying: a greeting at the start of a message
VOCAB hey  # a word a detector reads: known, so never read as a typo of another word
UNIT D greet.3  # detector for '^ hey there' (a greeting at the start of a message)
TAP greet.3 1 1 w:there 1  # '^ hey there': needs w:there at 1..1
TAP greet.3 0 0 pos:start 1  # '^ hey there': needs pos:start at 0..0
TAP greet.3 0 0 w:hey 1  # '^ hey there': needs w:hey at 0..0
BIAS D greet.3 -2  # AND of the 3 required parts of '^ hey there'
LINK U greet D:greet.3 1  # '^ hey there' is one way of saying: a greeting at the start of a message
UNIT U how_are_you  # asks how Helmus is
VOCAB how  # a word a detector reads: known, so never read as a typo of another word
VOCAB are  # a word a detector reads: known, so never read as a typo of another word
VOCAB you  # a word a detector reads: known, so never read as a typo of another word
UNIT D how_are_you.0  # detector for 'how are you' (asks how Helmus is)
TAP how_are_you.0 1 1 w:are 1  # 'how are you': needs w:are at 1..1
TAP how_are_you.0 2 2 w:you 1  # 'how are you': needs w:you at 2..2
TAP how_are_you.0 0 0 w:how 1  # 'how are you': needs w:how at 0..0
BIAS D how_are_you.0 -2  # AND of the 3 required parts of 'how are you'
LINK U how_are_you D:how_are_you.0 1  # 'how are you' is one way of saying: asks how Helmus is
VOCAB it  # a word a detector reads: known, so never read as a typo of another word
UNIT D how_are_you.1  # detector for 'how is it going' (asks how Helmus is)
TAP how_are_you.1 1 1 w:is 1  # 'how is it going': needs w:is at 1..1
TAP how_are_you.1 2 2 w:it 1  # 'how is it going': needs w:it at 2..2
TAP how_are_you.1 3 3 w:going 1  # 'how is it going': needs w:going at 3..3
TAP how_are_you.1 0 0 w:how 1  # 'how is it going': needs w:how at 0..0
BIAS D how_are_you.1 -3  # AND of the 4 required parts of 'how is it going'
LINK U how_are_you D:how_are_you.1 1  # 'how is it going' is one way of saying: asks how Helmus is
UNIT D how_are_you.2  # detector for 'how you doing' (asks how Helmus is)
TAP how_are_you.2 1 1 w:you 1  # 'how you doing': needs w:you at 1..1
TAP how_are_you.2 2 2 w:doing 1  # 'how you doing': needs w:doing at 2..2
TAP how_are_you.2 0 0 w:how 1  # 'how you doing': needs w:how at 0..0
BIAS D how_are_you.2 -2  # AND of the 3 required parts of 'how you doing'
LINK U how_are_you D:how_are_you.2 1  # 'how you doing' is one way of saying: asks how Helmus is
UNIT D how_are_you.3  # detector for 'how are things' (asks how Helmus is)
TAP how_are_you.3 1 1 w:are 1  # 'how are things': needs w:are at 1..1
TAP how_are_you.3 2 2 w:things 1  # 'how are things': needs w:things at 2..2
TAP how_are_you.3 0 0 w:how 1  # 'how are things': needs w:how at 0..0
BIAS D how_are_you.3 -2  # AND of the 3 required parts of 'how are things'
LINK U how_are_you D:how_are_you.3 1  # 'how are things' is one way of saying: asks how Helmus is
VOCAB your  # a word a detector reads: known, so never read as a typo of another word
VOCAB day  # a word a detector reads: known, so never read as a typo of another word
UNIT D how_are_you.4  # detector for 'how is your day' (asks how Helmus is)
TAP how_are_you.4 1 1 w:is 1  # 'how is your day': needs w:is at 1..1
TAP how_are_you.4 2 2 w:your 1  # 'how is your day': needs w:your at 2..2
TAP how_are_you.4 3 3 w:day 1  # 'how is your day': needs w:day at 3..3
TAP how_are_you.4 0 0 w:how 1  # 'how is your day': needs w:how at 0..0
