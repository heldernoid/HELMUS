LINK U tell_name D:tell_name.0.1 1  # '^ hi|hey|hello my name is {name:content}' is one way of saying: the user says their name
VOCAB am  # a word a detector reads: known, so never read as a typo of another word
UNIT D tell_name.1  # detector for 'i am called {name:content}' (the user says their name)
TAP tell_name.1 -1 -1 w:called 1  # 'i am called {name:content}': needs w:called at -1..-1
TAP tell_name.1 -2 -2 w:am 1  # 'i am called {name:content}': needs w:am at -2..-2
TAP tell_name.1 -3 -3 w:i 1  # 'i am called {name:content}': needs w:i at -3..-3
TAP tell_name.1 0 0 shape:content 1  # 'i am called {name:content}': needs shape:content at 0..0
BIAS D tell_name.1 -3  # AND of the 4 required parts of 'i am called {name:content}'
LINK U tell_name D:tell_name.1 1  # 'i am called {name:content}' is one way of saying: the user says their name
VOCAB me  # a word a detector reads: known, so never read as a typo of another word
UNIT D tell_name.2  # detector for '^ call me {name:content}' (the user says their name)
TAP tell_name.2 -1 -1 w:me 1  # '^ call me {name:content}': needs w:me at -1..-1
TAP tell_name.2 -2 -2 w:call 1  # '^ call me {name:content}': needs w:call at -2..-2
TAP tell_name.2 -2 -2 pos:start 1  # '^ call me {name:content}': needs pos:start at -2..-2
TAP tell_name.2 0 0 shape:content 1  # '^ call me {name:content}': needs shape:content at 0..0
