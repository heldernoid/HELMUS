TAP bt_type_word.6 -2 -2 w:just 1  # 'just say {word}': needs w:just at -2..-2
TAP bt_type_word.6 0 0 shape:any 1  # 'just say {word}': needs shape:any at 0..0
BIAS D bt_type_word.6 -2  # AND of the 3 required parts of 'just say {word}'
LINK U bt_type_word D:bt_type_word.6 1  # 'just say {word}' is one way of saying: asks Helmus to type one exact word (banana): a reply does it, or asks why
UNIT D bt_type_word.7  # detector for 'write the word {word}' (asks Helmus to type one exact word (banana): a reply does it, or asks why)
TAP bt_type_word.7 -1 -1 w:word 1  # 'write the word {word}': needs w:word at -1..-1
TAP bt_type_word.7 -2 -2 w:the 1  # 'write the word {word}': needs w:the at -2..-2
TAP bt_type_word.7 -3 -3 w:write 1  # 'write the word {word}': needs w:write at -3..-3
TAP bt_type_word.7 0 0 shape:any 1  # 'write the word {word}': needs shape:any at 0..0
BIAS D bt_type_word.7 -3  # AND of the 4 required parts of 'write the word {word}'
LINK U bt_type_word D:bt_type_word.7 1  # 'write the word {word}' is one way of saying: asks Helmus to type one exact word (banana): a reply does it, or asks why
UNIT D bt_type_word.8  # detector for 'type exactly' (asks Helmus to type one exact word (banana): a reply does it, or asks why)
TAP bt_type_word.8 1 1 w:exactly 1  # 'type exactly': needs w:exactly at 1..1
TAP bt_type_word.8 0 0 w:type 1  # 'type exactly': needs w:type at 0..0
BIAS D bt_type_word.8 -1  # AND of the 2 required parts of 'type exactly'
LINK U bt_type_word D:bt_type_word.8 1  # 'type exactly' is one way of saying: asks Helmus to type one exact word (banana): a reply does it, or asks why
UNIT D bt_type_word.9  # detector for 'copy this' (asks Helmus to type one exact word (banana): a reply does it, or asks why)
TAP bt_type_word.9 1 1 w:this 1  # 'copy this': needs w:this at 1..1
TAP bt_type_word.9 0 0 w:copy 1  # 'copy this': needs w:copy at 0..0
