LINK U tell_name D:tell_name.2 1  # '^ call me {name:content}' is one way of saying: the user says their name
UNIT D tell_name.3  # detector for '^ i am {name:unknown} $' (the user says their name)
TAP tell_name.3 0 0 pos:end 1  # '^ i am {name:unknown} $': needs pos:end at 0..0
TAP tell_name.3 -1 -1 w:am 1  # '^ i am {name:unknown} $': needs w:am at -1..-1
TAP tell_name.3 -2 -2 w:i 1  # '^ i am {name:unknown} $': needs w:i at -2..-2
TAP tell_name.3 -2 -2 pos:start 1  # '^ i am {name:unknown} $': needs pos:start at -2..-2
TAP tell_name.3 0 0 shape:unknown 1  # '^ i am {name:unknown} $': needs shape:unknown at 0..0
